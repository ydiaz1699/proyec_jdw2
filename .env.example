# My.JDownloader credentials
JD_EMAIL=tu_email@example.com
JD_PASSWORD=tu_contraseña
JD_DEVICE_NAME=nombre_del_dispositivo

# Optional: logging level for the MCP server (DEBUG, INFO, WARNING, ERROR)
JD_LOG_LEVEL=INFO

# Captcha Auto-Solver (optional, paid/hosted solvers used as fallback)
NOPECHA_API_KEY=          # Free: 100 req/day sin key. Get key at https://nopecha.com
TWOCAPTCHA_API_KEY=       # No free tier. Get key at https://2captcha.com
